# Copy to .env.local and add your API key. Check the Groq console for current model availability.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Gemini alternative: comment out the Groq lines above and uncomment these.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=gemini-3.8-flash  # verified 2026-10-12; one reply took ~29 s, so raise the llm.ts timeout before relying on it

DEMO_CACHE=0

# Image detection: fast pass (Groq vision) and second opinion (Gemini). Check each console for current model names.
VISION_BASE_URL=https://api.groq.com/openai/v1
VISION_API_KEY=
VISION_MODEL=qwen/qwen3.8-27b
CONFIRM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CONFIRM_API_KEY=
# Comma list = fallback order when a model is busy. 2026-10-14: Lite models ~1.3 s and most reliable in our eval;
# 3.5-flash often 503/429; 3.7/3.8-flash timed out.
CONFIRM_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# --- Shared crew status (Supabase) --------------------------------------------------------------
# Aarnav set up a project during the hackathon; if these are blank, see supabase/README.md.
# Reading the map and plans never needs these: without them TipOff runs exactly as it does today,
# read-only, and the crew status UI stays hidden.
# The anon key is public by design and safe in the browser bundle; row-level security is what
# stops it writing (supabase/migrations/0001_crew_status.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security, so it must never be prefixed NEXT_PUBLIC_.
# Not needed yet; leave blank unless a server route is added that has to act for everyone.
SUPABASE_SERVICE_ROLE_KEY=
